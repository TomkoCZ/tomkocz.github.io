<?xml version="1.0" encoding="UTF-8"?>
<addon id="plugin.toustello.youtube"
       name="YouTube"
       version="0.0.2"
       provider-name="Toustello">

    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>

    <extension point="xbmc.python.pluginsource"
           library="main.py">
    <provides>video</provides>
</extension>

<extension point="xbmc.service"
           library="service.py"/>
    <extension point="xbmc.addon.metadata">
        <summary lang="cs_CZ">YouTube</summary>
        <description lang="cs_CZ">
            YouTube plugin with yt-dlp and adaptive streaming.
        </description>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>
